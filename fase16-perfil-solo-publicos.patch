-            href="/registro?role=client"
-            className="rounded-full bg-cx-celeste px-5 py-2.5 text-sm font-semibold text-cx-noche hover:brightness-105 transition"
-          >
-            Regístrate
-          </a>
+          <div className="flex items-center gap-3">
