diff --git a/components/ShareButton.tsx b/components/ShareButton.tsx
new file mode 100644
index 0000000..f2fcf4c
--- /dev/null
+++ b/components/ShareButton.tsx
@@ -0,0 +1,36 @@
+"use client";
+
+import { useState } from "react";
+
+// Compartir con el menú del móvil (navigator.share) o, si no existe, copia el enlace.
+export default function ShareButton({ titulo }: { titulo: string }) {
+  const [copiado, setCopiado] = useState(false);
+
+  async function compartir() {
+    const url = window.location.href;
+    try {
+      if (navigator.share) {
+        await navigator.share({ title: titulo, url });
+        return;
+      }
+      await navigator.clipboard.writeText(url);
+      setCopiado(true);
+      setTimeout(() => setCopiado(false), 2000);
+    } catch {
+      /* el usuario cerró el menú de compartir */
+    }
+  }
+
+  return (
+    <button
+      type="button"
+      onClick={compartir}
+      className="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/25 text-white text-sm font-semibold px-4 py-2 hover:bg-white/20 transition"
+    >
+      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+        <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v14" />
+      </svg>
+      <span aria-live="polite">{copiado ? "Enlace copiado" : "Compartir"}</span>
+    </button>
+  );
+}
diff --git a/supabase/add-provider-promesa-chips.sql b/supabase/add-provider-promesa-chips.sql
new file mode 100644
index 0000000..1e9867c
--- /dev/null
+++ b/supabase/add-provider-promesa-chips.sql
@@ -0,0 +1,12 @@
+-- Fase 5 (perfil público): frase de promesa (máx. 140 caracteres) y hasta
+-- 3 chips de prueba social. Es aditivo: no toca datos existentes.
+alter table providers add column if not exists promesa text;
+alter table providers add column if not exists chips text[];
+
+alter table providers drop constraint if exists providers_promesa_len;
+alter table providers add constraint providers_promesa_len
+  check (promesa is null or char_length(promesa) <= 140);
+
+alter table providers drop constraint if exists providers_chips_max3;
+alter table providers add constraint providers_chips_max3
+  check (chips is null or coalesce(array_length(chips, 1), 0) <= 3);
