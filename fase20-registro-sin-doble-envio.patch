Subject: [PATCH] registro y login: boton que se bloquea al enviar, error en
 espanol y redireccion si ya hay sesion

---
 app/auth/actions.ts           |  6 +++++-
 app/login/LoginForm.tsx       |  8 ++++++--
 app/registro/RegistroForm.tsx |  6 ++++--
 app/registro/page.tsx         | 12 ++++++++++++
 components/SubmitButton.tsx   | 29 +++++++++++++++++++++++++++++
 5 files changed, 56 insertions(+), 5 deletions(-)
 create mode 100644 components/SubmitButton.tsx

diff --git a/app/auth/actions.ts b/app/auth/actions.ts
index 006db5e..804df36 100644
--- a/app/auth/actions.ts
+++ b/app/auth/actions.ts
@@ -57,7 +57,11 @@ export async function signUp(formData: FormData) {
   const { data, error } = await supabase.auth.signUp({ email, password });
 
   if (error) {
-    redirect(`/registro?error=${encodeURIComponent(error.message)}`);
+    const yaExiste = error.message.toLowerCase().includes("already registered");
+    const mensaje = yaExiste
+      ? "Ya existe una cuenta con este correo. Si eres tú, entra desde «Inicia sesión»."
+      : error.message;
+    redirect(`/registro?error=${encodeURIComponent(mensaje)}`);
   }
 
   const user = data.user;
