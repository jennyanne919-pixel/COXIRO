diff --git a/app/registro/page.tsx b/app/registro/page.tsx
index dbcaab8..f7a0158 100644
--- a/app/registro/page.tsx
+++ b/app/registro/page.tsx
@@ -1,3 +1,5 @@
+import { redirect } from "next/navigation";
+import { createClient } from "@/lib/supabase/server";
 import RegistroForm from "./RegistroForm";
 
 export default async function RegistroPage({
@@ -6,5 +8,15 @@ export default async function RegistroPage({
   searchParams: Promise<{ error?: string; ["check-email"]?: string; ref?: string; role?: string; slug?: string }>;
 }) {
   const sp = await searchParams;
+
+  // Si ya hay sesión (por ejemplo, tras registrarse), no tiene sentido volver
+  // a mostrar el registro: se va al panel. Evita ver un error de "usuario ya
+  // registrado" cuando la cuenta se creó bien.
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (user) redirect("/dashboard");
+
   return <RegistroForm searchParams={sp} />;
 }
diff --git a/components/SubmitButton.tsx b/components/SubmitButton.tsx
new file mode 100644
index 0000000..eed10d8
--- /dev/null
+++ b/components/SubmitButton.tsx
@@ -0,0 +1,29 @@
+"use client";
+
+import { useFormStatus } from "react-dom";
+
+// Botón de envío que se bloquea mientras el formulario se procesa, para que
+// nadie lo pulse varias veces (registro y login tardan unos segundos).
+export default function SubmitButton({
+  className,
+  children,
+  pendingText,
+  disabled,
+}: {
+  className: string;
+  children: React.ReactNode;
+  pendingText: string;
+  disabled?: boolean;
+}) {
+  const { pending } = useFormStatus();
+  return (
+    <button
+      type="submit"
+      disabled={pending || disabled}
+      aria-busy={pending}
+      className={`${className} ${pending ? "opacity-70 cursor-wait" : ""}`}
+    >
+      {pending ? pendingText : children}
+    </button>
+  );
+}
