# Supabase — Project Settings > API en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La "service_role" key -- NUNCA la pongas en código de cliente ni la subas a git
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# URL donde corre la app. En local, déjalo así.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Datos fiscales de Coxiro para las facturas (rellenar antes de
# facturar con clientes reales -- usar los datos de la autónoma)
COXIRO_TAX_ID=
COXIRO_LEGAL_NAME=
