diff --git a/lib/tax-id.ts b/lib/tax-id.ts
new file mode 100644
index 0000000..0cd23c0
--- /dev/null
+++ b/lib/tax-id.ts
@@ -0,0 +1,48 @@
+// Validación de identificadores fiscales españoles (NIF, NIE y CIF),
+// con comprobación del dígito/letra de control.
+
+const LETRAS_NIF = "TRWAGMYFPDXBNJZSQVHLCKE";
+
+export function normalizarTaxId(valor: string): string {
+  return (valor ?? "").toUpperCase().replace(/[\s.\-_/]/g, "");
+}
+
+export function esNifOrNie(valor: string): boolean {
+  const v = normalizarTaxId(valor);
+  if (/^[0-9]{8}[A-Z]$/.test(v)) {
+    return LETRAS_NIF[parseInt(v.slice(0, 8), 10) % 23] === v[8];
+  }
+  if (/^[XYZ][0-9]{7}[A-Z]$/.test(v)) {
+    const num = "XYZ".indexOf(v[0]) + v.slice(1, 8);
+    return LETRAS_NIF[parseInt(num, 10) % 23] === v[8];
+  }
+  return false;
+}
+
+export function esCif(valor: string): boolean {
+  const v = normalizarTaxId(valor);
+  if (!/^[ABCDEFGHJKLMNPQRSUVW][0-9]{7}[0-9A-J]$/.test(v)) return false;
+  const digitos = v.slice(1, 8).split("").map(Number);
+  let suma = 0;
+  digitos.forEach((d, i) => {
+    if (i % 2 === 0) {
+      const doble = d * 2;
+      suma += Math.floor(doble / 10) + (doble % 10);
+    } else {
+      suma += d;
+    }
+  });
+  const control = (10 - (suma % 10)) % 10;
+  const letra = "JABCDEFGHI"[control];
+  const tipo = v[0];
+  const ultimo = v[8];
+  // Sociedades que usan letra de control: K, P, Q, R, S, N, W.
+  if ("KPQRSNW".includes(tipo)) return ultimo === letra;
+  // Las de dígito de control: A, B, E, H.
+  if ("ABEH".includes(tipo)) return ultimo === String(control);
+  return ultimo === String(control) || ultimo === letra;
+}
+
+export function esTaxIdValido(valor: string, sociedad: boolean): boolean {
+  return sociedad ? esCif(valor) : esNifOrNie(valor);
+}
diff --git a/supabase/add-provider-legal-type.sql b/supabase/add-provider-legal-type.sql
new file mode 100644
index 0000000..d99f1e4
--- /dev/null
+++ b/supabase/add-provider-legal-type.sql
@@ -0,0 +1,11 @@
+-- Fase 10: profesionales que venden como sociedad (SL, SA...) o como
+-- autónomo/persona física. legal_name es el nombre fiscal (razón social
+-- o nombre y apellidos) que aparece como emisor en la autofactura;
+-- business_name sigue siendo el nombre comercial público.
+-- Es aditivo: los profesionales existentes quedan como autónomos.
+alter table providers add column if not exists legal_type text not null default 'autonomo';
+alter table providers add column if not exists legal_name text;
+
+alter table providers drop constraint if exists providers_legal_type_check;
+alter table providers add constraint providers_legal_type_check
+  check (legal_type in ('autonomo', 'sociedad'));
